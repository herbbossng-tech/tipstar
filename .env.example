# =============================================================================
# SPORT INTELLIGENCE OS — ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit a real .env file. NEVER put production secrets in this file.
# All values below are placeholders/categories, not real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Sport Intelligence OS
APP_VERSION=0.1.0
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Frontend (Mini App) — Vite only exposes VITE_-prefixed vars to the client.
# -----------------------------------------------------------------------------
VITE_APP_NAME=Sport Intelligence OS
VITE_API_BASE_URL=http://localhost:8787
# Client-visible mirror of DEV_AUTH_MODE below — only controls whether the
# Mini App SHOWS a dev-login button; grants no capability on its own.
VITE_DEV_AUTH_MODE=disabled

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Public — safe to expose to the Mini App client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key

# SERVER-ONLY. Bypasses RLS. Never send to the client / Mini App bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# SERVER-ONLY. Used for Bot API calls and Mini App initData validation.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# SERVER-ONLY. Must match the secret_token registered with Telegram's setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret

# Replay-protection window for Telegram initData (Section 02).
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_INIT_DATA_CLOCK_SKEW_SECONDS=60

# SERVER-ONLY. Signs the stateless auth session token issued after
# Telegram identity verification. Required in production.
SESSION_SIGNING_SECRET=replace-with-session-signing-secret
SESSION_TOKEN_TTL_SECONDS=86400

# Gated dev-mode Telegram authentication bypass. NEVER usable when
# APP_ENV=production, regardless of this value — see
# docs/architecture/TELEGRAM_AUTHENTICATION.md.
DEV_AUTH_MODE=disabled

# SERVER-ONLY. One-time OWNER bootstrap secret (Section 03). Leave unset
# to keep bootstrap permanently unavailable — a safe default, not
# something you must configure. See docs/architecture/AUTHORIZATION.md.
OWNER_BOOTSTRAP_SECRET=replace-with-owner-bootstrap-secret

# -----------------------------------------------------------------------------
# Data providers (abstracted — provider name selects the adapter; never
# hard-code a specific vendor's logic into core packages)
# -----------------------------------------------------------------------------
FOOTBALL_DATA_PROVIDER=replace-with-provider-name
FOOTBALL_DATA_API_KEY=replace-with-football-data-api-key
# Section 04 — Provider Configuration. No live provider is connected in
# this codebase; these are the knobs a real adapter's ProviderConfig
# would read once one is (see packages/football-engine/src/provider.ts
# and docs/architecture/FOOTBALL_DATA_ARCHITECTURE.md). FOOTBALL_DATA_ENABLED
# defaults to false and the numeric ones default sanely if left unset —
# BASE_URL/RATE_LIMIT/POLL_INTERVAL are commented out (not set to an
# empty string) so leaving them untouched keeps them genuinely absent.
FOOTBALL_DATA_ENABLED=false
# FOOTBALL_DATA_BASE_URL=
FOOTBALL_DATA_TIMEOUT_MS=5000
FOOTBALL_DATA_MAX_RETRIES=2
# FOOTBALL_DATA_RATE_LIMIT_PER_MINUTE=
# FOOTBALL_DATA_POLL_INTERVAL_SECONDS=

ODDS_PROVIDER=replace-with-provider-name
ODDS_API_KEY=replace-with-odds-api-key
ODDS_ENABLED=false
# ODDS_BASE_URL=
ODDS_TIMEOUT_MS=5000
ODDS_MAX_RETRIES=2
# ODDS_RATE_LIMIT_PER_MINUTE=
# ODDS_POLL_INTERVAL_SECONDS=

AVIATOR_DATA_PROVIDER=replace-with-provider-name
AVIATOR_DATA_API_KEY=replace-with-aviator-data-api-key

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------
# manual | assisted | disabled — see docs/architecture/OPEN_QUESTIONS.md.
# Never assume SportyBet exposes an undocumented public API.
SPORTYBET_INTEGRATION_MODE=disabled

# -----------------------------------------------------------------------------
# Scheduling
# -----------------------------------------------------------------------------
JOBS_ENABLED=false
