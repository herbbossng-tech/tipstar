# =============================================================================
# TIPSTAR — ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit a real .env file. NEVER put production secrets in this file.
# All values below are placeholders.
# =============================================================================

# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Public — safe to expose to the Mini App client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key

# SERVER-ONLY. Never send to the client / Mini App bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# SERVER-ONLY. Legacy (HS256) project JWT secret — Project Settings > API in
# the Supabase dashboard, or `supabase status` locally. Used to sign/verify
# Tipstar application session tokens so PostgREST/RLS accept them.
TIPSTAR_JWT_SECRET=replace-with-supabase-jwt-secret

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# SERVER-ONLY. Used to validate Mini App initData and to authenticate the Bot API.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=replace-with-bot-username
# Secret path/token used to verify inbound Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
# Public Mini App URL registered with @BotFather.
TELEGRAM_MINIAPP_URL=https://miniapp.example.com
# Public channel used for pick/result distribution (username or numeric id).
TELEGRAM_CHANNEL_ID=replace-with-channel-id
# Max age (seconds) an initData payload is considered fresh (replay window).
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
# development | staging | production — which Telegram bot/Mini App config this is.
TELEGRAM_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Session (Section 02 — issued only after validated Telegram initData)
# -----------------------------------------------------------------------------
# How long an application session token is valid for, in seconds.
SESSION_TOKEN_TTL_SECONDS=21600
# DEVELOPMENT ONLY. Never set to "true" outside local/dev environments — see
# docs/architecture/telegram-security.md#development-mode. Ignored entirely
# in production regardless of this value.
TIPSTAR_DEV_AUTH_BYPASS=false

# -----------------------------------------------------------------------------
# Core API
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:8787

# -----------------------------------------------------------------------------
# Sports data providers (abstracted — provider name selects the adapter)
# -----------------------------------------------------------------------------
SPORTS_PROVIDER=mock
SPORTS_PROVIDER_API_KEY=replace-with-provider-api-key
SPORTS_PROVIDER_BASE_URL=https://example-sports-provider.example.com

ODDS_PROVIDER=mock
ODDS_PROVIDER_API_KEY=replace-with-odds-provider-api-key

# -----------------------------------------------------------------------------
# LLM provider (explanation/interpretation layer only — see docs/architecture)
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Payment provider (subscription billing — abstracted)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_API_KEY=replace-with-payment-provider-key
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-payment-webhook-secret

# -----------------------------------------------------------------------------
# Affiliate / partner provider (attribution tracking — abstracted)
# -----------------------------------------------------------------------------
AFFILIATE_PROVIDER=mock
AFFILIATE_PROVIDER_API_KEY=replace-with-affiliate-provider-key

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
NOTIFICATION_PROVIDER=telegram
