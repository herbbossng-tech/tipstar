# =============================================================================
# SPORT INTELLIGENCE OS — ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit a real .env file. NEVER put production secrets in this file.
# All values below are placeholders/categories, not real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Sport Intelligence OS
APP_VERSION=0.1.0
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Frontend (Mini App) — Vite only exposes VITE_-prefixed vars to the client.
# -----------------------------------------------------------------------------
VITE_APP_NAME=Sport Intelligence OS
VITE_API_BASE_URL=http://localhost:8787

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Public — safe to expose to the Mini App client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key

# SERVER-ONLY. Bypasses RLS. Never send to the client / Mini App bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# SERVER-ONLY. Used for Bot API calls and Mini App initData validation.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# SERVER-ONLY. Must match the secret_token registered with Telegram's setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret

# -----------------------------------------------------------------------------
# Data providers (abstracted — provider name selects the adapter; never
# hard-code a specific vendor's logic into core packages)
# -----------------------------------------------------------------------------
FOOTBALL_DATA_PROVIDER=replace-with-provider-name
FOOTBALL_DATA_API_KEY=replace-with-football-data-api-key

ODDS_PROVIDER=replace-with-provider-name
ODDS_API_KEY=replace-with-odds-api-key

AVIATOR_DATA_PROVIDER=replace-with-provider-name
AVIATOR_DATA_API_KEY=replace-with-aviator-data-api-key

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------
# manual | assisted | disabled — see docs/architecture/OPEN_QUESTIONS.md.
# Never assume SportyBet exposes an undocumented public API.
SPORTYBET_INTEGRATION_MODE=disabled

# -----------------------------------------------------------------------------
# Scheduling
# -----------------------------------------------------------------------------
JOBS_ENABLED=false
