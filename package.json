{
  "name": "tipstar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tipstar - sports intelligence and betting companion platform (Telegram Mini App + Supabase backend)",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:miniapp": "pnpm --filter @tipstar/miniapp dev",
    "dev:bot": "pnpm --filter @tipstar/bot dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tipstar/decision-engine": "workspace:*",
    "@tipstar/intelligence": "workspace:*",
    "@tipstar/performance": "workspace:*",
    "@tipstar/picks": "workspace:*",
    "@tipstar/settlement": "workspace:*",
    "@tipstar/sports": "workspace:*",
    "@tipstar/types": "workspace:*",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
